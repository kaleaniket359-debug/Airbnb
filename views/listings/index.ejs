<% layout('layouts/boilerplate') -%>
<body>
    

    <h1 style="text-align: center;">All Places</h1>
    <!-- <form method="get" action="/listings/new">
        <button>add new info</button>
    </form> -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for(let listing of allListing){ %>
            <a href="/listings/<%=listing._id %>" class="listing-links">
        <div class="card col">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listingimage" style="height:20rem">
            <div class="card-body">
                <p class="card-text"><b><%= listing.title %> </b><br>
                <%- '&#8377;' %><%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> per 12 hours
                </p>
            </div>
        </div>
    </a>
<%}%>
    </div>
</body>